{
  "configuration": {
    "formatAbout": {
      "info": "**BioSeek feature-chart demo.** Synthetic data for `test_data/feature-chart`; nothing here comes from a real cohort. Use the track selector to toggle the six demo tracks, hover a chart for the maximize icon, and open a track's About dialog to see this site-wide text."
    }
  },
  "plugins": [
    {
      "esmLoc": {
        "uri": "plugins/sampleChartDrawers.js"
      }
    }
  ],
  "assemblies": [
    {
      "name": "volvox",
      "displayName": "Volvox (demo)",
      "aliases": ["vvx"],
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "volvox_refseq",
        "adapter": {
          "type": "TwoBitAdapter",
          "twoBitLocation": {
            "uri": "/test_data/volvox/volvox.2bit",
            "locationType": "UriLocation"
          }
        }
      }
    }
  ],
  "defaultSession": {
    "name": "Feature chart demo",
    "views": [
      {
        "id": "feature_chart_demo_view",
        "type": "LinearGenomeView",
        "init": {
          "loc": "ctgA:500-18,500",
          "assembly": "volvox",
          "tracks": [
            "fc_precomputed",
            "fc_raw_box",
            "fc_violin",
            "fc_bar",
            "fc_histogram",
            "fc_plugin_heatmap",
            "fc_plugin_dots",
            "fc_broken",
            "fc_missing_plugin",
            "fc_spec_box_plain",
            "fc_spec_box",
            "fc_spec_bar",
            "fc_spec_hist",
            "fc_spec_broken"
          ]
        }
      }
    ],
    "widgets": {
      "hierarchicalTrackSelector": {
        "id": "hierarchicalTrackSelector",
        "type": "HierarchicalTrackSelectorWidget",
        "filterText": "",
        "view": "feature_chart_demo_view"
      }
    },
    "activeWidgets": {
      "hierarchicalTrackSelector": "hierarchicalTrackSelector"
    }
  },
  "tracks": [
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_precomputed",
      "name": "FC · precomputed box (no drawer key)",
      "category": ["Feature chart demo"],
      "description": "Omitted `drawer` on purpose: this track proves the schema default is a real drawer. It also carries a track-level `formatAbout.info`, which overrides the site-wide text.",
      "metadata": {
        "source": "GTEx v8 (synthetic)"
      },
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/precomputed-box.tsv.gz"
      },
      "formatAbout": {
        "info": "**{{track.name}}**\n\nPrecomputed five-number summaries, one box per tissue. Source `{{track.metadata.source}}`, adapter `{{track.adapter.type}}`, assembly `{{assembly.displayName}}`. This paragraph lives in the track's `formatAbout.info` and overrides the site-wide default."
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_precomputed-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_raw_box",
      "name": "FC · raw box plot",
      "category": ["Feature chart demo"],
      "description": "Same file as the violin track, different drawer: raw observations are aggregated by the drawer at render time.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "dataLocation": {
          "uri": "/test_data/feature-chart/raw-values.tsv.gz",
          "locationType": "UriLocation"
        },
        "index": {
          "location": {
            "uri": "/test_data/feature-chart/raw-values.tsv.gz.tbi",
            "locationType": "UriLocation"
          }
        }
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_raw_box-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "rawBoxPlot",
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left",
            "colorScheme": "set2"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_violin",
      "name": "FC · raw violin plot",
      "category": ["Feature chart demo"],
      "description": "Identical adapter and data to the raw box track; only `renderer.drawer` differs.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/raw-values.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_violin-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "rawViolinPlot",
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left",
            "colorScheme": "viridis"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_bar",
      "name": "FC · bar plot",
      "category": ["Feature chart demo"],
      "description": "`data.bars` — one bar per category, values supplied by the file.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/bars.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_bar-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "barPlot",
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_histogram",
      "name": "FC · histogram (track info off)",
      "category": ["Feature chart demo"],
      "description": "`data.values` — a single numeric series. `formatAbout.showInfo: false` suppresses the info card for this track only; every other demo track shows it.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/histogram.tsv.gz"
      },
      "formatAbout": {
        "showInfo": false
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_histogram-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "histogram",
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_broken",
      "name": "FC · unknown drawer (failure semantics)",
      "category": ["Feature chart demo"],
      "description": "`tissueBoxPlot` was the old (invalid) default. The track must render a readable placeholder with the available drawer names and must not fail the track.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/precomputed-box.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_broken-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "tissueBoxPlot",
            "chartWidth": 160,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_plugin_heatmap",
      "name": "FC · plugin drawer (samplePlugin/heatmap)",
      "category": ["Feature chart demo"],
      "description": "Drawer contributed by an external no-build plugin (config.plugins[0].esmLoc.uri → test_data/feature-chart/plugins/sampleChartDrawers.js). `drawerOptions` picks the color ramp and the cell gap, so the same drawer can render several forms.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/raw-values.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_plugin_heatmap-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "samplePlugin/heatmap",
            "drawerOptions": {
              "colorRamp": "warm",
              "cellGap": 2
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_plugin_dots",
      "name": "FC · plugin drawer (samplePlugin/dotPlot)",
      "category": ["Feature chart demo"],
      "description": "Same plugin, second drawer, different mark. `drawerOptions` controls dot radius, jitter and opacity — one implementation, several looks.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/raw-values.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_plugin_dots-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "samplePlugin/dotPlot",
            "drawerOptions": {
              "dotRadius": 2.2,
              "jitter": 0.8,
              "fillOpacity": 0.55
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_missing_plugin",
      "name": "FC · drawer from a plugin that is not loaded",
      "category": ["Feature chart demo"],
      "description": "`notLoadedPlugin/heatmap` is never registered: the track must render a placeholder that says the plugin is missing and names the plugin to add, not just \"unknown drawer\".",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/raw-values.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_missing_plugin-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "notLoadedPlugin/heatmap",
            "chartWidth": 160,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_spec_box",
      "name": "FC · spec box (summary-stats + yLabel)",
      "category": ["Feature chart demo"],
      "description": "`drawer: \"spec\"`: the same chart as `fc_precomputed`, described declaratively (kind box, data.form summary-stats, path boxes) plus an axes.yLabel the legacy drawer cannot draw. See plugins/feature-chart/SPEC.md.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/precomputed-box.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_spec_box-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "spec",
            "spec": {
              "specVersion": 1,
              "kind": "box",
              "data": {
                "form": "summary-stats",
                "path": "boxes"
              },
              "axes": {
                "yLabel": "TPM"
              },
              "style": {
                "colorScheme": "tableau10"
              }
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_spec_bar",
      "name": "FC · spec bar (category-values)",
      "category": ["Feature chart demo"],
      "description": "Same bars as `fc_bar`, but described in the config: kind bar, data.form category-values, path bars, palette picked in spec.style.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/bars.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_spec_bar-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "spec",
            "spec": {
              "specVersion": 1,
              "kind": "bar",
              "data": {
                "form": "category-values",
                "path": "bars"
              },
              "style": {
                "colorScheme": "set2"
              }
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_spec_hist",
      "name": "FC · spec histogram (values, 16 bins)",
      "category": ["Feature chart demo"],
      "description": "kind histogram with spec.style.bins = 16 (the legacy `histogram` drawer always used 10) and a yLabel.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/histogram.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_spec_hist-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "spec",
            "spec": {
              "specVersion": 1,
              "kind": "histogram",
              "data": {
                "form": "values",
                "path": "values"
              },
              "style": {
                "bins": 16
              },
              "axes": {
                "yLabel": "genes"
              }
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_spec_broken",
      "name": "FC · invalid spec (failure semantics)",
      "category": ["Feature chart demo"],
      "description": "kind violin with data.form summary-stats: an illegal combination. Must render a placeholder naming the path and the allowed forms, and the maximize dialog must list the problem. The track itself stays alive.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/precomputed-box.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_spec_broken-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "spec",
            "spec": {
              "specVersion": 1,
              "kind": "violin",
              "data": {
                "form": "summary-stats",
                "path": "boxes"
              }
            },
            "chartWidth": 160,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    },
    {
      "type": "FeatureChartTrack",
      "trackId": "fc_spec_box_plain",
      "name": "FC · spec box (no yLabel, pixel-identical to legacy)",
      "category": ["Feature chart demo"],
      "description": "Same adapter, same data and same geometry as `fc_precomputed`, but described by a spec instead of the `precomputedBoxPlot` drawer. The two tracks must be pixel-identical: that is what 'v1 adds nothing the old painters could not draw' means. `fc_spec_box` is the same spec plus `axes.yLabel`.",
      "assemblyNames": ["volvox"],
      "adapter": {
        "type": "FeatureChartTabixAdapter",
        "uri": "/test_data/feature-chart/precomputed-box.tsv.gz"
      },
      "displays": [
        {
          "type": "LinearFeatureChartDisplay",
          "displayId": "fc_spec_box_plain-LinearFeatureChartDisplay",
          "renderer": {
            "type": "FeatureChartRenderer",
            "drawer": "spec",
            "spec": {
              "specVersion": 1,
              "kind": "box",
              "data": {
                "form": "summary-stats",
                "path": "boxes"
              }
            },
            "chartWidth": 120,
            "chartHeight": 180,
            "align": "left"
          }
        }
      ]
    }
  ]
}
